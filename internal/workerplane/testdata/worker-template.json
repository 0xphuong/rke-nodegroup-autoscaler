 {
  "Name": "/kubelet",
  "Config": {
   "Image": "rancher/hyperkube:v1.32.6-rancher1",
   "Entrypoint": [
    "/opt/rke-tools/entrypoint.sh",
    "kubelet",
    "--pod-infra-container-image=rancher/mirrored-pause:3.7",
    "--root-dir=/var/lib/kubelet",
    "--volume-plugin-dir=/var/lib/kubelet/volumeplugins",
    "--authorization-mode=Webhook",
    "--cgroups-per-qos=True",
    "--event-qps=0",
    "--resolv-conf=/etc/resolv.conf",
    "--cluster-dns=10.43.0.10",
    "--anonymous-auth=false",
    "--make-iptables-util-chains=true",
    "--tls-cipher-suites=TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305",
    "--v=2",
    "--cluster-domain=cluster.local",
    "--fail-swap-on=false",
    "--hostname-override=worker-0",
    "--kubeconfig=/etc/kubernetes/ssl/kubecfg-kube-node.yaml",
    "--address=0.0.0.0",
    "--authentication-token-webhook=true",
    "--streaming-connection-idle-timeout=30m",
    "--cloud-provider=",
    "--container-runtime-endpoint=unix:///var/run/cri-dockerd.sock",
    "--read-only-port=0",
    "--client-ca-file=/etc/kubernetes/ssl/kube-ca.pem"
   ],
   "Cmd": null,
   "Env": [
    "RKE_KUBELET_CRIDOCKERD=true",
    "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
   ],
   "Labels": {
    "io.rancher.rke.container.name": "kubelet",
    "org.opencontainers.image.created": "2025-07-10T07:05:27.381Z",
    "org.opencontainers.image.description": "Rancher hyperkube images",
    "org.opencontainers.image.licenses": "Apache-2.0",
    "org.opencontainers.image.ref.name": "ubuntu",
    "org.opencontainers.image.revision": "f10141dfbc1c5a3c508185944c17a8118ab7fc60",
    "org.opencontainers.image.source": "https://github.com/rancher/hyperkube",
    "org.opencontainers.image.title": "hyperkube",
    "org.opencontainers.image.url": "https://github.com/rancher/hyperkube",
    "org.opencontainers.image.version": "v1.32.6-rancher1"
   }
  },
  "HostConfig": {
   "NetworkMode": "host",
   "PidMode": "host",
   "Privileged": true,
   "Binds": [
    "/var/lib/cri-dockerd:/var/lib/cri-dockerd",
    "/etc/kubernetes:/etc/kubernetes",
    "/etc/cni:/etc/cni:rw",
    "/opt/cni:/opt/cni:rw",
    "/var/lib/cni:/var/lib/cni",
    "/var/lib/calico:/var/lib/calico",
    "/etc/resolv.conf:/etc/resolv.conf",
    "/sys:/sys:rprivate",
    "/var/lib/docker:/var/lib/docker:rw,rslave",
    "/var/lib/kubelet:/var/lib/kubelet:shared",
    "/var/lib/rancher:/var/lib/rancher:shared",
    "/var/run:/var/run:rw,rprivate",
    "/run:/run:rprivate",
    "/etc/ceph:/etc/ceph",
    "/dev:/host/dev:rprivate",
    "/var/log/containers:/var/log/containers",
    "/var/log/pods:/var/log/pods",
    "/usr:/host/usr:ro",
    "/etc:/host/etc:ro",
    "/data:/data:rshared",
    "/csi:/csi:rshared"
   ],
   "VolumesFrom": [
    "service-sidekick"
   ],
   "SecurityOpt": [
    "label=disable"
   ],
   "RestartPolicy": {
    "Name": "always"
   },
   "LogConfig": {
    "Type": "json-file",
    "Config": {
     "max-file": "3",
     "max-size": "512m"
    }
   }
  }
 },
